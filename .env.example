# Copia questo file in .env e valorizza le variabili.
# Il file .env e' in .gitignore: non deve finire nel repository.

# API key NVD (facoltativa ma fortemente consigliata: alza il rate limit da
# 5 a 50 richieste ogni 30 secondi).
# Richiedila gratuitamente su https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Percorso alternativo del database SQLite.
# Default: ~/.local/share/nvdlocal/nvd.db
#NVDLOCAL_DB=/var/lib/nvdlocal/nvd.db
